{
  "name": "royal-velvet-suite",
  "private": true,
  "version": "1.0.0",
  "description": "Royal Velvet Suite — Jeu PC de salon Monte-Carlo (Belote, Bridge, Poker, Blackjack, Baccarat)",
  "author": "Royal Velvet Suite",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-win server.js",
    "lint": "tsc --noEmit",
    "build:icon": "node scripts/generate-win-icon.mjs",
    "desktop:check": "node scripts/check-desktop-readiness.mjs",
    "pack:win": "npm run build:icon && npm run build && npx --yes electron-builder --config electron-builder.yml --win --x64 --publish never",
    "pack:win:unsigned": "npm run build:icon && npm run build && npx --yes electron-builder --config electron-builder.yml --win --x64 -c.win.signAndEditExecutable=false --publish never",
    "verify:win-sign": "powershell -ExecutionPolicy Bypass -File scripts/verify-signature.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^14.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postprocessing": "^6.39.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
